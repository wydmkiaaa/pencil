rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidReviewIntervals(obj) {
      return obj is map
        && obj.keys().hasAll(['hardDays', 'midDays', 'easyDays'])
        && obj.keys().hasOnly(['hardDays', 'midDays', 'easyDays'])
        && obj.hardDays is number && obj.hardDays >= 1 && obj.hardDays <= 365
        && obj.midDays is number && obj.midDays >= 1 && obj.midDays <= 365
        && obj.easyDays is number && obj.easyDays >= 1 && obj.easyDays <= 365;
    }

    function isValidNotificationSettings(obj) {
      return obj is map
        && obj.keys().hasAll(['taskReminders', 'dueFlashcards', 'sessionChimes'])
        && obj.keys().hasOnly(['taskReminders', 'dueFlashcards', 'sessionChimes'])
        && obj.taskReminders is bool
        && obj.dueFlashcards is bool
        && obj.sessionChimes is bool;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'pastelTheme', 'dailyGoalMinutes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'avatarUrl', 'bio', 'pastelTheme', 'dailyGoalMinutes', 'reviewIntervals', 'notificationSettings', 'isPublic', 'shareStudyGoal', 'handle', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 100000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.pastelTheme in ['stone', 'sage', 'blush', 'sky', 'lavender', 'butter']
        && data.dailyGoalMinutes is number && data.dailyGoalMinutes >= 15 && data.dailyGoalMinutes <= 720
        && (!('reviewIntervals' in data) || isValidReviewIntervals(data.reviewIntervals))
        && (!('notificationSettings' in data) || isValidNotificationSettings(data.notificationSettings))
        && (!('isPublic' in data) || data.isPublic is bool)
        && (!('shareStudyGoal' in data) || data.shareStudyGoal is bool)
        && (!('handle' in data) || (data.handle is string && data.handle.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'handle', 'displayName', 'pastelTheme', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'handle', 'displayName', 'avatarUrl', 'bio', 'pastelTheme', 'isPublic', 'dailyGoalMinutes', 'shareStudyGoal', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.handle is string && data.handle.size() >= 3 && data.handle.size() <= 32 && data.handle.matches('^[a-z0-9_\\-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 100000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.pastelTheme in ['stone', 'sage', 'blush', 'sky', 'lavender', 'butter']
        && data.isPublic is bool
        && (!('dailyGoalMinutes' in data) || (data.dailyGoalMinutes is number && data.dailyGoalMinutes >= 15 && data.dailyGoalMinutes <= 720))
        && (!('shareStudyGoal' in data) || data.shareStudyGoal is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendLink(data) {
      return data.keys().hasAll(['ownerId', 'friendUid', 'handle', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'friendUid', 'handle', 'displayName', 'avatarUrl', 'bio', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.friendUid)
        && data.handle is string && data.handle.size() >= 3 && data.handle.size() <= 32
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 100000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['fromUid', 'toUid', 'fromHandle', 'fromDisplayName', 'toHandle', 'toDisplayName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fromUid', 'toUid', 'fromHandle', 'fromDisplayName', 'fromAvatarUrl', 'fromBio', 'toHandle', 'toDisplayName', 'toAvatarUrl', 'toBio', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.fromUid)
        && isValidId(data.toUid)
        && data.fromUid != data.toUid
        && (data.fromUid == request.auth.uid || data.toUid == request.auth.uid)
        && data.fromHandle is string && data.fromHandle.size() >= 3 && data.fromHandle.size() <= 32 && data.fromHandle.matches('^[a-z0-9_\\-]+$')
        && data.fromDisplayName is string && data.fromDisplayName.size() >= 1 && data.fromDisplayName.size() <= 80
        && (!('fromAvatarUrl' in data) || (data.fromAvatarUrl is string && data.fromAvatarUrl.size() <= 100000))
        && (!('fromBio' in data) || (data.fromBio is string && data.fromBio.size() <= 300))
        && data.toHandle is string && data.toHandle.size() >= 3 && data.toHandle.size() <= 32 && data.toHandle.matches('^[a-z0-9_\\-]+$')
        && data.toDisplayName is string && data.toDisplayName.size() >= 1 && data.toDisplayName.size() <= 80
        && (!('toAvatarUrl' in data) || (data.toAvatarUrl is string && data.toAvatarUrl.size() <= 100000))
        && (!('toBio' in data) || (data.toBio is string && data.toBio.size() <= 300))
        && data.status in ['pending', 'accepted', 'declined']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyTask(data) {
      return data.keys().hasAll(['ownerId', 'title', 'priority', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'notes', 'priority', 'hardness', 'status', 'subjectId', 'dueAt', 'reminderAt', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.priority in ['low', 'medium', 'high']
        && (!('hardness' in data) || data.hardness in ['easy', 'medium', 'hard'])
        && data.status in ['not_started', 'working', 'completed']
        && (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128))
        && (!('dueAt' in data) || (data.dueAt is string && data.dueAt.size() <= 64))
        && (!('reminderAt' in data) || (data.reminderAt is string && data.reminderAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyGoal(data) {
      return data.keys().hasAll(['ownerId', 'title', 'targetDate', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'targetDate', 'completed', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isValidDateKey(data.targetDate)
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['ownerId', 'name', 'color', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'color', 'description', 'priority', 'hardness', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 24
        && (!('description' in data) || (data.description is string && data.description.size() <= 400))
        && (!('priority' in data) || data.priority in ['low', 'medium', 'high'])
        && (!('hardness' in data) || data.hardness in ['easy', 'medium', 'hard'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVideoLectureItem(item) {
      return item is map
        && item.keys().hasAll(['title', 'url'])
        && item.keys().hasOnly(['id', 'title', 'url', 'totalSeconds', 'watchedSeconds', 'lastWatchedAt'])
        && (!('id' in item) || (item.id is string && item.id.size() <= 64))
        && item.title is string && item.title.size() <= 160
        && item.url is string && item.url.size() <= 500
        && (!('totalSeconds' in item) || (item.totalSeconds is number && item.totalSeconds >= 0 && item.totalSeconds <= 864000))
        && (!('watchedSeconds' in item) || (item.watchedSeconds is number && item.watchedSeconds >= 0 && item.watchedSeconds <= 864000))
        && (!('lastWatchedAt' in item) || (item.lastWatchedAt is string && item.lastWatchedAt.size() <= 64));
    }

    function isValidChapter(data) {
      return data.keys().hasAll(['ownerId', 'subjectId', 'title', 'order', 'notes', 'videoLectures', 'pdfSources', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'subjectId', 'title', 'order', 'priority', 'hardness', 'notes', 'videoLectures', 'pdfSources', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.subjectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.order is number && data.order >= 0 && data.order <= 10000
        && (!('priority' in data) || data.priority in ['low', 'medium', 'high'])
        && (!('hardness' in data) || data.hardness in ['easy', 'medium', 'hard'])
        && data.notes is string && data.notes.size() <= 50000
        && data.videoLectures is list && data.videoLectures.size() <= 30
        && (data.videoLectures.size() == 0 || isValidVideoLectureItem(data.videoLectures[0]))
        && data.pdfSources is list && data.pdfSources.size() <= 15
        && (data.pdfSources.size() == 0 || (
          data.pdfSources[0] is map
          && data.pdfSources[0].keys().hasAll(['fileName', 'pageCount', 'extractedAt'])
          && data.pdfSources[0].keys().hasOnly(['fileName', 'pageCount', 'extractedAt'])
          && data.pdfSources[0].fileName is string && data.pdfSources[0].fileName.size() <= 200
          && data.pdfSources[0].pageCount is number
          && data.pdfSources[0].extractedAt is string && data.pdfSources[0].extractedAt.size() <= 64
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChapterPhoto(data) {
      return data.keys().hasAll(['ownerId', 'subjectId', 'chapterId', 'title', 'dataUrl', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'subjectId', 'chapterId', 'title', 'dataUrl', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.subjectId)
        && isValidId(data.chapterId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.dataUrl is string && data.dataUrl.size() >= 10 && data.dataUrl.size() <= 350000
        && data.createdAt is timestamp;
    }

    function isValidFlashcard(data) {
      return data.keys().hasAll(['ownerId', 'subjectId', 'front', 'back', 'repetitions', 'intervalDays', 'easeFactor', 'nextReviewAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'subjectId', 'chapterId', 'front', 'back', 'priority', 'hardness', 'repetitions', 'intervalDays', 'easeFactor', 'nextReviewAt', 'lastReviewedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.subjectId)
        && (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() <= 128))
        && data.front is string && data.front.size() >= 1 && data.front.size() <= 1000
        && data.back is string && data.back.size() >= 1 && data.back.size() <= 2000
        && (!('priority' in data) || data.priority in ['low', 'medium', 'high'])
        && (!('hardness' in data) || data.hardness in ['easy', 'medium', 'hard'])
        && data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 10000
        && data.intervalDays is number && data.intervalDays >= 0 && data.intervalDays <= 36500
        && data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 5.0
        && data.nextReviewAt is string && data.nextReviewAt.size() >= 10 && data.nextReviewAt.size() <= 64
        && (!('lastReviewedAt' in data) || (data.lastReviewedAt is string && data.lastReviewedAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlurtWeakPoint(item) {
      return item is map
        && item.keys().hasAll(['topic', 'gap', 'suggestedReview'])
        && item.keys().hasOnly(['topic', 'gap', 'suggestedReview'])
        && item.topic is string && item.topic.size() <= 200
        && item.gap is string && item.gap.size() <= 1000
        && item.suggestedReview is string && item.suggestedReview.size() <= 1000;
    }

    function isValidBlurtSession(data) {
      return data.keys().hasAll(['ownerId', 'sourceLabel', 'blurtText', 'durationSeconds', 'summary', 'strongPoints', 'weakPoints', 'missedKeyFacts', 'dateKey', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'subjectId', 'subjectName', 'chapterId', 'chapterTitle', 'sourceLabel', 'blurtText', 'durationSeconds', 'summary', 'strongPoints', 'weakPoints', 'missedKeyFacts', 'cardsGeneratedCount', 'dateKey', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() <= 128))
        && (!('chapterTitle' in data) || (data.chapterTitle is string && data.chapterTitle.size() <= 160))
        && data.sourceLabel is string && data.sourceLabel.size() >= 1 && data.sourceLabel.size() <= 200
        && data.blurtText is string && data.blurtText.size() >= 1 && data.blurtText.size() <= 20000
        && data.durationSeconds is number && data.durationSeconds >= 1 && data.durationSeconds <= 86400
        && data.summary is string && data.summary.size() <= 2000
        && data.strongPoints is list && data.strongPoints.size() <= 20
        && (data.strongPoints.size() == 0 || (data.strongPoints[0] is string && data.strongPoints[0].size() <= 600))
        && data.weakPoints is list && data.weakPoints.size() <= 20
        && (data.weakPoints.size() == 0 || isValidBlurtWeakPoint(data.weakPoints[0]))
        && data.missedKeyFacts is list && data.missedKeyFacts.size() <= 20
        && (data.missedKeyFacts.size() == 0 || (data.missedKeyFacts[0] is string && data.missedKeyFacts[0].size() <= 600))
        && (!('cardsGeneratedCount' in data) || (data.cardsGeneratedCount is number && data.cardsGeneratedCount >= 0 && data.cardsGeneratedCount <= 100))
        && isValidDateKey(data.dateKey)
        && data.createdAt is timestamp;
    }

    function isValidFocusSession(data) {
      return data.keys().hasAll(['ownerId', 'mode', 'contextType', 'durationSeconds', 'ambientSound', 'completedAt', 'dateKey', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'mode', 'contextType', 'roomId', 'roomName', 'subjectId', 'subjectName', 'subjectColor', 'chapterId', 'chapterTitle', 'durationSeconds', 'ambientSound', 'completedAt', 'dateKey', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.mode in ['timer', 'stopwatch', 'flashcards', 'blurting']
        && data.contextType in ['solo', 'public_room', 'private_room', 'active_recall']
        && (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128))
        && (!('roomName' in data) || (data.roomName is string && data.roomName.size() <= 120))
        && (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && (!('subjectColor' in data) || (data.subjectColor is string && data.subjectColor.size() <= 24))
        && (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() <= 128))
        && (!('chapterTitle' in data) || (data.chapterTitle is string && data.chapterTitle.size() <= 160))
        && data.durationSeconds is number && data.durationSeconds >= 1 && data.durationSeconds <= 86400
        && data.ambientSound in ['none', 'brown', 'pink', 'white', 'rain', 'forest']
        && data.completedAt is string && data.completedAt.size() >= 10 && data.completedAt.size() <= 64
        && isValidDateKey(data.dateKey)
        && data.createdAt is timestamp;
    }

    function isValidFocusRoom(data) {
      return data.keys().hasAll(['hostId', 'hostName', 'name', 'visibility', 'timerMode', 'timerDurationSeconds', 'timerStatus', 'timerStartedAtMs', 'timerAccumulatedSeconds', 'ambientSound', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['hostId', 'hostName', 'name', 'topic', 'visibility', 'timerMode', 'timerDurationSeconds', 'timerStatus', 'timerStartedAtMs', 'timerAccumulatedSeconds', 'ambientSound', 'chatEnabled', 'voiceEnabled', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.hostId)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 160))
        && data.visibility in ['public', 'private']
        && data.timerMode in ['timer', 'stopwatch']
        && data.timerDurationSeconds is number && data.timerDurationSeconds >= 60 && data.timerDurationSeconds <= 14400
        && data.timerStatus in ['idle', 'running', 'paused']
        && data.timerStartedAtMs is number && data.timerStartedAtMs >= 0
        && data.timerAccumulatedSeconds is number && data.timerAccumulatedSeconds >= 0 && data.timerAccumulatedSeconds <= 86400
        && data.ambientSound in ['none', 'brown', 'pink', 'white', 'rain', 'forest']
        && (!('chatEnabled' in data) || data.chatEnabled is bool)
        && (!('voiceEnabled' in data) || data.voiceEnabled is bool)
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomLock(data) {
      return data.keys().hasAll(['roomId', 'hostId', 'passwordHash', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'hostId', 'passwordHash', 'createdAt', 'updatedAt'])
        && isValidId(data.roomId)
        && isValidId(data.hostId)
        && data.hostId == request.auth.uid
        && data.passwordHash is string && data.passwordHash.size() >= 16 && data.passwordHash.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomPass(data) {
      return data.keys().hasAll(['uid', 'roomId', 'passHash', 'createdAt'])
        && data.keys().hasOnly(['uid', 'roomId', 'passHash', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidId(data.roomId)
        && data.passHash is string && data.passHash.size() >= 16 && data.passHash.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidRoomParticipant(data) {
      return data.keys().hasAll(['uid', 'roomId', 'roomVisibility', 'roomHostId', 'displayName', 'status', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'roomId', 'roomVisibility', 'roomHostId', 'displayName', 'avatarUrl', 'subjectName', 'status', 'voiceJoined', 'isMuted', 'isSpeaking', 'voiceSessionId', 'joinedAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidId(data.roomId)
        && data.roomVisibility in ['public', 'private']
        && isValidId(data.roomHostId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 100000))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && data.status in ['focusing', 'break', 'idle']
        && (!('voiceJoined' in data) || data.voiceJoined is bool)
        && (!('isMuted' in data) || data.isMuted is bool)
        && (!('isSpeaking' in data) || data.isSpeaking is bool)
        && (!('voiceSessionId' in data) || (data.voiceSessionId is string && data.voiceSessionId.size() <= 64))
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomMessage(data) {
      return data.keys().hasAll(['roomId', 'roomVisibility', 'roomHostId', 'senderId', 'senderName', 'text', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'roomVisibility', 'roomHostId', 'senderId', 'senderName', 'text', 'createdAt'])
        && isValidId(data.roomId)
        && data.roomVisibility in ['public', 'private']
        && isValidId(data.roomHostId)
        && isValidId(data.senderId)
        && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidRoomVoiceSignal(data) {
      return data.keys().hasAll(['roomId', 'roomVisibility', 'roomHostId', 'fromUid', 'toUid', 'sessionId', 'kind', 'payload', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'roomVisibility', 'roomHostId', 'fromUid', 'toUid', 'sessionId', 'kind', 'payload', 'createdAt'])
        && isValidId(data.roomId)
        && data.roomVisibility in ['public', 'private']
        && isValidId(data.roomHostId)
        && isValidId(data.fromUid)
        && data.fromUid == request.auth.uid
        && isValidId(data.toUid)
        && data.toUid != data.fromUid
        && data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 64
        && data.kind in ['offer', 'answer', 'ice', 'bye']
        && data.payload is string && data.payload.size() >= 1 && data.payload.size() <= 16000
        && data.createdAt is timestamp;
    }

    // --- User-Scoped Collections (Strict PII & Data Isolation) ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'avatarUrl', 'bio', 'pastelTheme', 'dailyGoalMinutes', 'reviewIntervals', 'notificationSettings', 'isPublic', 'shareStudyGoal', 'handle', 'updatedAt']);
      allow delete: if false;

      match /friends/{friendId} {
        allow get: if isOwner(userId) && isValidId(friendId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(friendId)
          && friendId != userId
          && isValidFriendLink(incoming())
          && incoming().friendUid == friendId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(friendId))
          && (
            get(/databases/$(database)/documents/publicProfiles/$(friendId)).data.isPublic == true
            || (
              exists(/databases/$(database)/documents/friendRequests/$(userId + '__' + friendId))
              && get(/databases/$(database)/documents/friendRequests/$(userId + '__' + friendId)).data.status == 'accepted'
            )
            || (
              exists(/databases/$(database)/documents/friendRequests/$(friendId + '__' + userId))
              && get(/databases/$(database)/documents/friendRequests/$(friendId + '__' + userId)).data.status == 'accepted'
            )
          );
        allow update: if isOwner(userId) && isValidId(friendId)
          && isValidFriendLink(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().friendUid == existing().friendUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['handle', 'displayName', 'avatarUrl', 'bio']);
        allow delete: if isOwner(userId) && isValidId(friendId);
      }

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(taskId)
          && isValidStudyTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(taskId)
          && isValidStudyTask(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'hardness', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'priority', 'hardness', 'status', 'subjectId', 'dueAt', 'reminderAt', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /dailyGoals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(goalId)
          && isValidDailyGoal(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(goalId)
          && isValidDailyGoal(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'targetDate', 'completed', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(subjectId)
          && isValidSubject(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(subjectId)
          && isValidSubject(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'hardness', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'description', 'priority', 'hardness', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /chapters/{chapterId} {
        allow get: if isOwner(userId) && isValidId(chapterId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(chapterId)
          && isValidChapter(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/subjects/$(incoming().subjectId));
        allow update: if isOwner(userId) && isValidId(chapterId)
          && isValidChapter(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().subjectId == existing().subjectId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'pdfSources', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['videoLectures', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'hardness', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'order', 'priority', 'hardness', 'notes', 'videoLectures', 'pdfSources', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(chapterId);
      }

      match /chapterPhotos/{photoId} {
        allow get: if isOwner(userId) && isValidId(photoId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(photoId)
          && isValidChapterPhoto(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/chapters/$(incoming().chapterId));
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(photoId);
      }

      match /flashcards/{flashcardId} {
        allow get: if isOwner(userId) && isValidId(flashcardId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(flashcardId)
          && isValidFlashcard(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/subjects/$(incoming().subjectId));
        allow update: if isOwner(userId) && isValidId(flashcardId)
          && isValidFlashcard(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().subjectId == existing().subjectId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['repetitions', 'intervalDays', 'easeFactor', 'nextReviewAt', 'lastReviewedAt', 'hardness', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'hardness', 'intervalDays', 'nextReviewAt', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['front', 'back', 'priority', 'hardness', 'intervalDays', 'nextReviewAt', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(flashcardId);
      }

      match /blurtSessions/{blurtId} {
        allow get: if isOwner(userId) && isValidId(blurtId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(blurtId)
          && isValidBlurtSession(incoming())
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(blurtId)
          && isValidBlurtSession(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['cardsGeneratedCount']);
        allow delete: if isOwner(userId) && isValidId(blurtId);
      }

      match /focusSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(sessionId)
          && isValidFocusSession(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }

    // --- Collaborative Focus Rooms ---
    match /focusRooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && (
        existing().visibility == 'public'
        || existing().hostId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(roomId)
        && isValidFocusRoom(incoming())
        && incoming().hostId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(roomId)
        && isValidFocusRoom(incoming())
        && existing().hostId == request.auth.uid
        && incoming().hostId == existing().hostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['timerMode', 'timerDurationSeconds', 'timerStatus', 'timerStartedAtMs', 'timerAccumulatedSeconds', 'ambientSound', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['chatEnabled', 'voiceEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'topic', 'visibility', 'chatEnabled', 'voiceEnabled', 'isActive', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      match /secrets/{lockId} {
        allow read: if false;
        allow create: if isSignedIn() && isValidId(roomId) && lockId == 'lock'
          && isValidRoomLock(incoming())
          && incoming().roomId == roomId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/focusRooms/$(roomId));
        allow update: if isSignedIn() && isValidId(roomId) && lockId == 'lock'
          && isValidRoomLock(incoming())
          && existing().hostId == request.auth.uid
          && incoming().hostId == existing().hostId
          && incoming().roomId == existing().roomId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(roomId) && lockId == 'lock' && existing().hostId == request.auth.uid;
      }

      match /passes/{userId} {
        allow get: if isOwner(userId) && isValidId(roomId) && isValidId(userId);
        allow list: if false;
        allow create: if isOwner(userId) && isValidId(roomId) && isValidId(userId)
          && isValidRoomPass(incoming())
          && incoming().roomId == roomId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/focusRooms/$(roomId)/secrets/lock)
          && incoming().passHash == get(/databases/$(database)/documents/focusRooms/$(roomId)/secrets/lock).data.passwordHash;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(roomId) && isValidId(userId);
      }

      match /participants/{participantId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(participantId) && (
          participantId == request.auth.uid
          || (resource != null && (
            existing().roomVisibility == 'public'
            || existing().uid == request.auth.uid
            || existing().roomHostId == request.auth.uid
          ))
          || exists(/databases/$(database)/documents/focusRooms/$(roomId)/participants/$(request.auth.uid))
        );
        allow list: if isSignedIn() && (
          existing().roomVisibility == 'public'
          || existing().uid == request.auth.uid
          || existing().roomHostId == request.auth.uid
          || exists(/databases/$(database)/documents/focusRooms/$(roomId)/participants/$(request.auth.uid))
        );
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(participantId)
          && participantId == request.auth.uid
          && isValidRoomParticipant(incoming())
          && incoming().roomId == roomId
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/focusRooms/$(roomId))
          && incoming().roomVisibility == getAfter(/databases/$(database)/documents/focusRooms/$(roomId)).data.visibility
          && incoming().roomHostId == getAfter(/databases/$(database)/documents/focusRooms/$(roomId)).data.hostId
          && (
            getAfter(/databases/$(database)/documents/focusRooms/$(roomId)).data.visibility == 'public'
            || getAfter(/databases/$(database)/documents/focusRooms/$(roomId)).data.hostId == request.auth.uid
            || existsAfter(/databases/$(database)/documents/focusRooms/$(roomId)/passes/$(request.auth.uid))
          );
        allow update: if isSignedIn() && isValidId(roomId) && isValidId(participantId)
          && participantId == request.auth.uid
          && isValidRoomParticipant(incoming())
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && incoming().roomVisibility == existing().roomVisibility
          && incoming().roomHostId == existing().roomHostId
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'subjectName', 'status', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['voiceJoined', 'isMuted', 'isSpeaking', 'voiceSessionId', 'updatedAt'])
          );
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(participantId)
          && (participantId == request.auth.uid || existing().roomHostId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && (
          (resource != null && (
            existing().roomVisibility == 'public'
            || existing().roomHostId == request.auth.uid
          ))
          || exists(/databases/$(database)/documents/focusRooms/$(roomId)/participants/$(request.auth.uid))
        );
        allow list: if isSignedIn() && (
          existing().roomVisibility == 'public'
          || existing().roomHostId == request.auth.uid
          || exists(/databases/$(database)/documents/focusRooms/$(roomId)/participants/$(request.auth.uid))
        );
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(messageId)
          && isValidRoomMessage(incoming())
          && incoming().roomId == roomId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/focusRooms/$(roomId))
          && incoming().roomVisibility == get(/databases/$(database)/documents/focusRooms/$(roomId)).data.visibility
          && incoming().roomHostId == get(/databases/$(database)/documents/focusRooms/$(roomId)).data.hostId
          && (
            get(/databases/$(database)/documents/focusRooms/$(roomId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/focusRooms/$(roomId)).data.hostId == request.auth.uid
            || exists(/databases/$(database)/documents/focusRooms/$(roomId)/participants/$(request.auth.uid))
          );
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(messageId)
          && (existing().senderId == request.auth.uid || existing().roomHostId == request.auth.uid);
      }

      match /voiceSignals/{signalId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(signalId) && (
          existing().toUid == request.auth.uid
          || existing().fromUid == request.auth.uid
        );
        allow list: if isSignedIn() && existing().toUid == request.auth.uid;
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(signalId)
          && isValidRoomVoiceSignal(incoming())
          && incoming().roomId == roomId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/focusRooms/$(roomId))
          && incoming().roomVisibility == get(/databases/$(database)/documents/focusRooms/$(roomId)).data.visibility
          && incoming().roomHostId == get(/databases/$(database)/documents/focusRooms/$(roomId)).data.hostId
          && exists(/databases/$(database)/documents/focusRooms/$(roomId)/participants/$(request.auth.uid));
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(signalId) && (
          existing().toUid == request.auth.uid
          || existing().fromUid == request.auth.uid
          || existing().roomHostId == request.auth.uid
        );
      }
    }

    // --- Discoverable Study Profiles (Zero PII; Private Profiles Require Request Approval) ---
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'avatarUrl', 'bio', 'pastelTheme', 'isPublic', 'dailyGoalMinutes', 'shareStudyGoal', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // --- Friend Requests for Private Study Profiles ---
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource == null
        || existing().fromUid == request.auth.uid
        || existing().toUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        existing().fromUid == request.auth.uid
        || existing().toUid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(requestId)
        && isValidFriendRequest(incoming())
        && incoming().fromUid == request.auth.uid
        && requestId == incoming().fromUid + '__' + incoming().toUid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().toUid));
      allow update: if isSignedIn() && isValidId(requestId)
        && isValidFriendRequest(incoming())
        && existing().toUid == request.auth.uid
        && existing().status == 'pending'
        && incoming().status in ['accepted', 'declined']
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().fromHandle == existing().fromHandle
        && incoming().fromDisplayName == existing().fromDisplayName
        && incoming().toHandle == existing().toHandle
        && incoming().toDisplayName == existing().toDisplayName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(requestId)
        && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }
  }
}
